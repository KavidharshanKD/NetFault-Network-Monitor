# ==============================================================================
# Automated Fault Detection System (AFDS)
# Supabase PostgreSQL & Environment Configuration Example
# ==============================================================================

# Supabase Project Configuration (Obtained from Supabase Project Settings -> API)
# Required for application persistence.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Alternative client key if service role is not used
# SUPABASE_KEY=your-supabase-anon-or-service-key

# Flask Application Security
SECRET_KEY=replace-with-a-random-secure-secret-key-for-production

# Default Administrator Credentials (for local login without Supabase Auth)
ADMIN_EMAIL=admin@supabase.local
ADMIN_PASSWORD=admin123

# Server Network Settings
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=0

# Immediate Email Alerts & SMTP Notification Configuration
# Example for Gmail: smtp.gmail.com:587 with App Password
# Example for Sendgrid/Mailgun: smtp.sendgrid.net:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
ALERT_SENDER_EMAIL=netfault-alerts@yourdomain.com
ALERT_RECIPIENT_EMAIL=noc-team@yourdomain.com
NETFAULT_PUBLIC_URL=http://127.0.0.1:5000
APP_TIMEZONE=Asia/Kolkata

